<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="12dp" android:background="@color/item_background">
    <ImageView android:id="@+id/iv_base_image" android:layout_width="60dp" android:layout_height="60dp"
        android:scaleType="centerCrop" android:src="@drawable/ic_launcher"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout android:id="@+id/ll_info" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp" android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/iv_base_image" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_use">
        <TextView android:id="@+id/tv_base_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/tv_base_barcode" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/barcode_color" android:layout_marginTop="2dp" />
    </LinearLayout>
    <ImageButton android:id="@+id/btn_use" android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_home" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Использовать в активных"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_color"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
